{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "one-dark-transparent",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "compact",
    "image_preview": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "new_location": "launch",
    "permissions": "autoaccept",
    "grouping": "auto"
  },
  "animations": true,
  "tabs": {
    "mode": "off"
  },
  "terminal": {
    "copy": "select"
  }
}
